-- 👇 PASTE YOUR ANIMATION ID NUMBER BETWEEN THE QUOTES BELOW 👇
local MY_ANIMATION_ID = "1234567890" 
local ANIMATION_SPEED = 0.5 

local seat = script.Parent
local currentTrack = nil

local animation = Instance.new("Animation")
animation.AnimationId = "rbxassetid://" .. string.gsub(MY_ANIMATION_ID, "%D", "")

seat:GetPropertyChangedSignal("Occupant"):Connect(function()
	local humanoid = seat.Occupant
	
	if humanoid then
		local character = humanoid.Parent
		local animator = humanoid:FindFirstChildOfClass("Animator")
		
		-- Turn off default core animations so they don't override your pose
		local animateScript = character:FindFirstChild("Animate")
		if animateScript then
			animateScript.Enabled = false
		end
		
		if animator then
			currentTrack = animator:LoadAnimation(animation)
			
			-- 🛠️ FORCE LOOP REGARDLESS OF ROBLOX SETTINGS
			currentTrack.Priority = Enum.AnimationPriority.Action4
			currentTrack.Looped = true          
			
			currentTrack:Play()
			currentTrack:AdjustSpeed(ANIMATION_SPEED) 
			
			-- 🛠️ BACKUP SAFETY LOOP: If it somehow stops, force it to play again!
			currentTrack.Stopped:Connect(function()
				if currentTrack and seat.Occupant == humanoid then
					currentTrack:Play()
					currentTrack:AdjustSpeed(ANIMATION_SPEED)
				end
			end)
		end
	else
		-- Player stood up, turn default animations back on
		if currentTrack then
			currentTrack:Stop()
			currentTrack = nil
		end
		
		-- Find the player who just stood up and turn their walk back on
		for _, child in pairs(workspace:GetChildren()) do
			local hum = child:FindFirstChildOfClass("Humanoid")
			local animScript = child:FindFirstChild("Animate")
			if hum and animScript and animScript.Enabled == false then
				animScript.Enabled = true
			end
		end
	end
end)
