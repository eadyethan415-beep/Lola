-- UI Styling Engines
local function neonStroke(parent, color, thickness)
	local s = Instance.new("UIStroke", parent)
	s.Color = color or Color3.fromRGB(0, 255, 200); s.Thickness = thickness or 2.5; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
end
local function round(parent, r) Instance.new("UICorner", parent).CornerRadius = UDim.new(0, r or 14) end
local function applyGrad(parent, kp)
	local g = Instance.new("UIGradient", parent); g.Color = ColorSequence.new(kp); g.Rotation = 45
end

