local activeClientPets = {}

local function clearLocalPet(player)
	if activeClientPets[player] then
		if activeClientPets[player].Model then activeClientPets[player].Model:Destroy() end
		activeClientPets[player] = nil
	end
end

local function spawnLocalPetPart(player, petConfig)
	clearLocalPet(player)
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	
	-- Build a local visual cube representing the pet completely client-side
	local petModel = Instance.new("Part")
	petModel.Name = "FE_ClientPet_" .. player.Name
	petModel.Size = Vector3.new(1.4, 1.4, 1.4)
	petModel.Color = petConfig.Color.Value
	petModel.Material = Enum.Material.Neon
	petModel.CanCollide = false
	petModel.Anchored = true
	petModel.Parent = workspace
	
	-- Draw floating face billboard text decoration overlay safely onto container
	local bb = Instance.new("BillboardGui", petModel)
	bb.Size = UDim2.new(0, 100, 0, 30); bb.AlwaysOnTop = true; bb.StudsOffset = Vector3.new(0, 1.2, 0)
	local tl = Instance.new("TextLabel", bb)
	tl.Size = UDim2.new(1, 0, 1, 0); tl.BackgroundTransparency = 1; tl.Text = petConfig.PetName.Value; tl.Font = Enum.Font.FredokaOne; tl.TextColor3 = Color3.fromRGB(255,255,255); tl.TextSize = 14
	neonStroke(tl, Color3.fromRGB(0,0,0), 2)

