local function triggerPopup(text, color)
	local pop = Instance.new("TextLabel", ScreenGui)
	pop.Size = UDim2.new(0, 250, 0, 60); pop.Position = UDim2.new(0.5, math.random(-120, 40), 0.35, math.random(-40, 40)); pop.BackgroundTransparency = 1
	pop.Text = text; pop.Font = Enum.Font.FredokaOne; pop.TextSize = 36; pop.TextColor3 = color or Color3.fromRGB(0, 255, 255)
	Instance.new("UIStroke", pop).Thickness = 4
	TweenService:Create(pop, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = pop.Position - UDim2.new(0, 0, 0, 90), TextSize = 46}):Play()
	task.delay(0.38, function() pop:Destroy() end)
end

local SideContainer = Instance.new("Frame", ScreenGui)
