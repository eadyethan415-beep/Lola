local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Create ScreenGui
local mainGui = Instance.new("ScreenGui")
mainGui.Name = "ObbyGui"
mainGui.ResetOnSpawn = false
mainGui.Parent = playerGui

---------------------------------------------------------
-- HELPER FUNCTIONS FOR SEAMLESS STYLING
---------------------------------------------------------
local function createButton(name, size, position, bgColor, parent)
	local button = Instance.new("ImageButton")
	button.Name = name
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = bgColor
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Parent = parent

	-- Rounded Corners
	local uiCorner = Instance.new("UICorner")
	uiCorner.CornerRadius = UDim.new(0, 12)
	uiCorner.Parent = button

	-- Thick Stroke Outlines
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Thickness = 3
	uiStroke.Color = Color3.fromRGB(0, 0, 0)
	uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	uiStroke.Parent = button

	-- Smooth Hover & Click Animations
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.15), {Size = size + UDim2.new(0, 4, 0, 4)}):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.15), {Size = size}):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.05), {ImageColor3 = Color3.fromRGB(200, 200, 200)}):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.05), {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
	end)

	return button
end

local function addLabel(text, size, position, parent)
	local label = Instance.new("TextLabel")
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne -- Matches iconic Roblox cartoony font styles
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextScaled = true
	
	-- Dark Text Border Outline
	local textStroke = Instance.new("UIStroke")
	textStroke.Thickness = 2.5
	textStroke.Color = Color3.fromRGB(0, 0, 0)
	textStroke.Parent = label
	
	label.Parent = parent
	return label
end

