local SideContainer = Instance.new("Frame", ScreenGui)
SideContainer.Size = UDim2.new(0, 400, 0, 90); SideContainer.Position = UDim2.new(0, 25, 0.5, -45); SideContainer.BackgroundTransparency = 1
local SideLayout = Instance.new("UIListLayout", SideContainer); SideLayout.FillDirection = Enum.FillDirection.Horizontal; SideLayout.Padding = UDim.new(0, 12)

local function buildHudBtn(text, startColor, endColor)
	local btn = Instance.new("TextButton", SideContainer)
	btn.Size = UDim2.new(0, 85, 0, 85); btn.Text = text; btn.Font = Enum.Font.FredokaOne; btn.TextColor3 = Color3.fromRGB(255, 255, 255); btn.TextSize = 14
	round(btn, 16); neonStroke(btn, startColor, 3); applyGrad(btn, {ColorSequenceKeypoint.new(0, startColor), ColorSequenceKeypoint.new(1, endColor)})
	return btn
end

