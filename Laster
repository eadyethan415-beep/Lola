-- Hide/Reveal Panel Logic Handler
local function linkPanelToggle(button, frame)
	button.MouseButton1Click:Connect(function() frame.Visible = not frame.Visible end)
end

-- Base Frame Panel Factory Blueprint
local function createMasterPanel(title, strokeColor)
	local p = Instance.new("Frame", ScreenGui)
	p.Size = UDim2.new(0, 360, 0, 400); p.Position = UDim2.new(0.5, -180, 0.5, -200); p.BackgroundColor3 = Color3.fromRGB(12, 11, 16); p.Visible = false
	round(p, 20); neonStroke(p, strokeColor, 3)
	local h = Instance.new("TextLabel", p); h.Size = UDim2.new(1, 0, 0, 50); h.Text = title; h.Font = Enum.Font.FredokaOne; h.TextColor3 = strokeColor; h.TextSize = 22; h.BackgroundTransparency = 1
	local s = Instance.new("ScrollingFrame", p); s.Size = UDim2.new(1, -24, 1, -70); s.Position = UDim2.new(0, 12, 0, 55); s.BackgroundTransparency = 1; s.ScrollBarThickness = 5; s.ScrollBarImageColor3 = strokeColor
	Instance.new("UIListLayout", s).Padding = UDim.new(0, 10)
	return p, s
end

